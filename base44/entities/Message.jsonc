{
  "name": "Message",
  "type": "object",
  "properties": {
    "resume_id": {
      "type": "string",
      "description": "Resume this message belongs to"
    },
    "sender_email": {
      "type": "string",
      "description": "Email of the sender"
    },
    "sender_name": {
      "type": "string",
      "description": "Name of the sender"
    },
    "content": {
      "type": "string",
      "description": "Message content"
    },
    "read": {
      "type": "boolean",
      "default": false,
      "description": "Whether the message has been read"
    }
  },
  "required": [
    "resume_id",
    "sender_email",
    "sender_name",
    "content"
  ]
}