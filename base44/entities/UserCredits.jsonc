{
  "name": "UserCredits",
  "type": "object",
  "properties": {
    "userId": {
      "type": "string",
      "description": "User email"
    },
    "coins": {
      "type": "number",
      "default": 100,
      "description": "Available coins"
    },
    "earnedTotal": {
      "type": "number",
      "default": 100,
      "description": "Total coins earned"
    },
    "spentTotal": {
      "type": "number",
      "default": 0,
      "description": "Total coins spent"
    },
    "lastEarned": {
      "type": "string",
      "format": "date-time",
      "description": "Last time coins were earned"
    }
  },
  "required": [
    "userId",
    "coins"
  ]
}